#!/usr/bin/env bash
set -euo pipefail

command -v trufflehog >/dev/null 2>&1 || {
  echo "trufflehog is required; refusing to skip the secret scan." >&2
  exit 1
}

RESULTS="$(mktemp)"
trap 'rm -f "$RESULTS"' EXIT
chmod 600 "$RESULTS"

set +e
trufflehog stdin --json --no-update --fail --fail-on-scan-errors --results=verified,unknown < /dev/stdin >"$RESULTS" 2>/dev/null
status=$?
set -e

case "$status" in
  0) exit 0 ;;
  183)
    echo "TruffleHog blocked the operation. Potential secret types:" >&2
    if command -v jq >/dev/null 2>&1; then
      jq -r '.DetectorName // "unknown detector"' "$RESULTS" | sort -u | sed 's/^/  - /' >&2
    else
      echo "  (install jq for redacted detector names)" >&2
    fi
    echo "Raw secret values are intentionally suppressed." >&2
    exit 1
    ;;
  *) echo "TruffleHog scan failed (exit $status); refusing to continue." >&2; exit 1 ;;
esac
