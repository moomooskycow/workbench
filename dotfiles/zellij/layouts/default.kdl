// Default layout — Ember "connected powerline" bar via zjstatus.
// Symlinked to ~/.config/zellij/layouts/default.kdl (see install.sh).
// Plugins live in ~/.config/zellij/plugins/ (run install.sh or fetch manually).
//
// Powerline arrows ( ) + glyphs require a Nerd Font. The desktop
// terminal already has one; on Blink (mobile) set the font to a Nerd Font.
//
// zjstatus needs ReadApplicationState permission once — granted in
// ~/Library/Caches/org.Zellij-Contributors.Zellij/permissions.kdl. A *new*
// session (or new tab via `--layout`) reads that grant on a fresh load.
//
// Design: connected powerline at the SECTION level —
//   [mode] ▸ [ session ] ▸ [ tab  tab  tab … ] ▸            ◂ [ clock ]
// Tabs share ONE continuous overlay strip; active tab pops via copper text.
// Palette = Ghostty Ember (charcoal + copper).
layout {
    default_tab_template {
        // ── Bar pane (TOP). Move below `children` to put the bar at the bottom. ──
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                // session arrow bleeds into the overlay tab-strip; strip closes into base.
                // amber #e8a849 · panel #1c1820 · void #131119 · lift #2a2430
                format_left  "{mode}#[bg=#e8a849,fg=#131119]  {session} #[fg=#e8a849,bg=#1c1820]{tabs}#[fg=#1c1820,bg=#131119]"
                format_right "#[fg=#1c1820,bg=#131119]{datetime}"
                format_space "#[bg=#131119]"
                border_enabled "false"
                hide_frame_for_single_pane "true"

                // ── Mode flag: empty in normal; otherwise a colored pill whose arrow
                //    bleeds into the copper session segment (trailing bg = amber). ──
                mode_normal       ""
                mode_locked       "#[bg=#d46a6a,fg=#131119] LOCKED #[fg=#d46a6a,bg=#e8a849]"
                mode_pane         "#[bg=#e8a849,fg=#131119] PANE #[fg=#e8a849,bg=#e8a849]"
                mode_tab          "#[bg=#7aab9c,fg=#131119] TAB #[fg=#7aab9c,bg=#e8a849]"
                mode_resize       "#[bg=#d4a54c,fg=#131119] RESIZE #[fg=#d4a54c,bg=#e8a849]"
                mode_move         "#[bg=#d4a54c,fg=#131119] MOVE #[fg=#d4a54c,bg=#e8a849]"
                mode_scroll       "#[bg=#7a9ec2,fg=#131119] SCROLL #[fg=#7a9ec2,bg=#e8a849]"
                mode_enter_search "#[bg=#7a9ec2,fg=#131119] SEARCH #[fg=#7a9ec2,bg=#e8a849]"
                mode_search       "#[bg=#7a9ec2,fg=#131119] SEARCH #[fg=#7a9ec2,bg=#e8a849]"
                mode_session      "#[bg=#7a9ec2,fg=#d5cec4] SESSION #[fg=#7a9ec2,bg=#e8a849]"
                mode_rename_tab   "#[bg=#7aab9c,fg=#131119] RENAME #[fg=#7aab9c,bg=#e8a849]"
                mode_rename_pane  "#[bg=#e8a849,fg=#131119] RENAME #[fg=#e8a849,bg=#e8a849]"

                // ── Tabs: ONE continuous overlay strip, no arrows between them.
                //    Active = copper; inactive = warm muted. ──
                tab_normal            "#[bg=#1c1820,fg=#9a9288] {index} {name} "
                tab_active            "#[bg=#1c1820,fg=#e8a849] {index} {name} "
                tab_normal_fullscreen "#[bg=#1c1820,fg=#9a9288] {index} {name} {fullscreen_indicator}"
                tab_active_fullscreen "#[bg=#1c1820,fg=#e8a849] {index} {name} {fullscreen_indicator}"
                tab_normal_sync       "#[bg=#1c1820,fg=#9a9288] {index} {name} {sync_indicator}"
                tab_active_sync       "#[bg=#1c1820,fg=#e8a849] {index} {name} {sync_indicator}"
                tab_fullscreen_indicator " "
                tab_sync_indicator       " "
                tab_floating_indicator   "󰉈 "

                // ── Right: clock in a surface segment with a left-pointing edge. ──
                datetime          "#[bg=#1c1820,fg=#9a9288]  {format} "
                datetime_format   "%a %d %b · %H:%M"
                datetime_timezone "America/Chicago"
            }
        }
        children
    }
}
