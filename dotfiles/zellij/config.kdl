// Zellij — optimized for mobile (mosh + Blink + Tailscale) and desktop.
// Priorities: session survival across disconnects, low UI overhead, big scrollback.

// --- UI: keep the layout lean, but let the chrome breathe --------------------
// Arrow separators render correctly here, so use the richer bar styling.
simplified_ui false
pane_frames false
default_layout "default"

// --- Scrollback + session persistence ----------------------------------------
// Agents (Claude Code, etc.) dump a lot; mobile networks drop.
// session_serialization keeps panes+tabs+commands across zellij restarts.
// viewport serialization + scrollback bytes keeps context after resurrection.
// NOTE: the option is `serialize_pane_viewport`. The old name
// `pane_viewport_serialization` was NOT a real zellij key, so it was silently
// ignored and scrollback was never actually serialized — which is why a
// resurrected session came back blank. Fixed 2026-06-18.
scroll_buffer_size 100000
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 10000

// --- Clipboard ---------------------------------------------------------------
// Zellij runs on the Mac; pbcopy targets the Mac clipboard regardless of
// which device is attached. Handy: copy on phone → paste on desktop later.
copy_command "pbcopy"
copy_clipboard "system"
copy_on_select false

// --- Touch / mouse -----------------------------------------------------------
// Blink forwards taps as mouse events — click panes/tabs directly from phone.
mouse_mode true

// --- Safety ------------------------------------------------------------------
// Terminal window close detaches the session instead of killing it.
on_force_close "detach"

// --- Startup -----------------------------------------------------------------
show_startup_tips false
show_release_notes false

// --- Theme -------------------------------------------------------------------
// Ember — charcoal + copper (matches Ghostty Ember).
themes {
    ember {
        // bg #131119=19,17,25  panel #1c1820=28,24,32  lift #2a2430=42,36,48
        // fg #d5cec4=213,206,196  dim #6f6878=111,104,120  line #4a4458=74,68,88
        // amber #e8a849=232,168,73  gold #d4a54c=212,165,76  blue #7a9ec2=122,158,194
        // teal #7aab9c=122,171,156  green #8aab7c=138,171,124  red #d46a6a=212,106,106
        text_unselected {
            base 213 206 196
            background 19 17 25
            emphasis_0 232 168 73
            emphasis_1 122 171 156
            emphasis_2 122 158 194
            emphasis_3 212 165 76
        }
        text_selected {
            base 213 206 196
            background 61 46 31
            emphasis_0 232 168 73
            emphasis_1 122 171 156
            emphasis_2 122 158 194
            emphasis_3 212 165 76
        }
        ribbon_selected {
            base 19 17 25
            background 232 168 73
            emphasis_0 212 106 106
            emphasis_1 212 165 76
            emphasis_2 122 171 156
            emphasis_3 122 158 194
        }
        ribbon_unselected {
            base 213 206 196
            background 42 36 48
            emphasis_0 232 168 73
            emphasis_1 111 104 120
            emphasis_2 122 171 156
            emphasis_3 212 165 76
        }
        table_title {
            base 232 168 73
            background 19 17 25
            emphasis_0 212 165 76
            emphasis_1 122 171 156
            emphasis_2 122 158 194
            emphasis_3 138 171 124
        }
        table_cell_selected {
            base 213 206 196
            background 61 46 31
            emphasis_0 232 168 73
            emphasis_1 122 171 156
            emphasis_2 122 158 194
            emphasis_3 212 165 76
        }
        table_cell_unselected {
            base 213 206 196
            background 19 17 25
            emphasis_0 232 168 73
            emphasis_1 122 171 156
            emphasis_2 122 158 194
            emphasis_3 212 165 76
        }
        list_selected {
            base 213 206 196
            background 61 46 31
            emphasis_0 232 168 73
            emphasis_1 122 171 156
            emphasis_2 122 158 194
            emphasis_3 212 165 76
        }
        list_unselected {
            base 213 206 196
            background 19 17 25
            emphasis_0 232 168 73
            emphasis_1 122 171 156
            emphasis_2 122 158 194
            emphasis_3 212 165 76
        }
        frame_selected {
            base 232 168 73
            background 19 17 25
            emphasis_0 212 165 76
            emphasis_1 122 171 156
            emphasis_2 122 158 194
            emphasis_3 19 17 25
        }
        frame_highlight {
            base 232 168 73
            background 19 17 25
            emphasis_0 212 106 106
            emphasis_1 122 171 156
            emphasis_2 122 158 194
            emphasis_3 212 165 76
        }
        exit_code_success {
            base 138 171 124
            background 19 17 25
            emphasis_0 122 171 156
            emphasis_1 19 17 25
            emphasis_2 232 168 73
            emphasis_3 74 68 88
        }
        exit_code_error {
            base 212 106 106
            background 19 17 25
            emphasis_0 232 168 73
            emphasis_1 19 17 25
            emphasis_2 19 17 25
            emphasis_3 19 17 25
        }
        multiplayer_user_colors {
            player_1 232 168 73
            player_2 122 171 156
            player_3 122 158 194
            player_4 138 171 124
            player_5 212 165 76
            player_6 212 106 106
            player_7 213 206 196
            player_8 111 104 120
            player_9 74 68 88
            player_10 19 17 25
        }
    }
}
theme "ember"

// --- Keybinds ----------------------------------------------------------------
// Single-chord session swaps that work from any mode (incl. inside an agent TUI).
// `shared_except "locked"` = fires in every mode except Locked, so Zellij
// intercepts the chord before the focused pane (e.g. Claude/Codex) sees it.
keybinds {
    shared_except "locked" {
        // --- Anti-accidental-quit ---------------------------------------------
        // Zellij's default `Ctrl q` => Quit is a foot-gun: one fat-finger ends
        // the whole session (it becomes resurrectable, but live processes die
        // and, pre-fix, scrollback was lost). Repurpose the reflex key to the
        // SAFE action: Detach. The session keeps running in the background and
        // every pane/process stays alive — reattach with `zellij attach <name>`.
        // Intentional quit is now deliberate only:
        //   • session-manager picker: `Alt o` (kill/exit a session from the list)
        //   • shell: `zellij kill-session <name>` or `zellij delete-session <name>`
        unbind "Ctrl q"
        bind "Ctrl q" { Detach; }

        bind "Alt p" { SwitchSession name="personal"; }
        bind "Alt w" { SwitchSession name="work"; }
        // Open the session-manager picker directly — skips Ctrl-o w mode dance.
        bind "Alt o" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
            };
        }
        // Alt t — fuzzy TAB switcher (room): a full vertical list, type-to-filter,
        // Enter to jump, or press a tab's number. The fix for "many tabs, one line".
        // (New sessions only — Zellij doesn't hot-reload keybinds. For the current
        //  session use the `zw` shell alias, which does the same thing live.)
        bind "Alt t" {
            LaunchOrFocusPlugin "file:~/.config/zellij/plugins/room.wasm" {
                floating true
                ignore_case true
                quick_jump true
            };
        }
        // Alt 1-9 — jump straight to a tab by index.
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
    }
}

// --- Plugins -----------------------------------------------------------------
// Keep the compact footer, but let F1 reveal the full keybinding help overlay.
plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    compact-bar location="zellij:compact-bar" {
        tooltip "F1"
    }
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    filepicker location="zellij:strider" {
        cwd "/"
    }
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
    about location="zellij:about"
}
