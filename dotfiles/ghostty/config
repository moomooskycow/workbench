# ══════════════════════════════════════════════════════════════════════════════
#  G H O S T T Y  ·  Ember workstation
#  Warm ink, restrained translucency, dense agent-friendly ergonomics.
# ══════════════════════════════════════════════════════════════════════════════

# ── Color system ─────────────────────────────────────────────────────────────
theme = light:Ember Dawn,dark:Ember
window-theme = auto
background-opacity = 0.55
background-blur = 22
minimum-contrast = 1.2
bold-color = bright
faint-opacity = 0.62

# ── Typography ───────────────────────────────────────────────────────────────
# Installed locally; carries the Nerd glyphs used by OMP's chrome/status line.
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
font-feature = +calt
font-feature = +liga
font-feature = +zero
adjust-cell-height = 4%
adjust-underline-position = 1
adjust-underline-thickness = 1
adjust-cursor-thickness = 1
adjust-box-thickness = 1

# ── Window chrome ────────────────────────────────────────────────────────────
gtk-single-instance = true
gtk-titlebar = true
gtk-titlebar-style = tabs
gtk-toolbar-style = flat
gtk-wide-tabs = false
gtk-titlebar-hide-when-maximized = true
window-save-state = always
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-padding-color = extend
window-inherit-working-directory = true
window-inherit-font-size = true
window-new-tab-position = current
window-step-resize = true
resize-overlay = after-first
resize-overlay-position = bottom-right
resize-overlay-duration = 450ms

# ── Focus and input ──────────────────────────────────────────────────────────
unfocused-split-opacity = 0.82
focus-follows-mouse = true
cursor-style = bar
cursor-style-blink = false
cursor-opacity = 0.92
mouse-hide-while-typing = true
cursor-click-to-move = true

# ── Shell, links, and clipboard ──────────────────────────────────────────────
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-terminfo,ssh-env
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
copy-on-select = clipboard
link-url = true

# ── Quick terminal ───────────────────────────────────────────────────────────
# A 42%-high command deck on Super+grave. COSMIC/Wayland provides the global
# shortcut backend; Ctrl+grave remains an in-app fallback.
keybind = global:super+grave_accent=toggle_quick_terminal
keybind = ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 42%
gtk-quick-terminal-layer = overlay
gtk-quick-terminal-namespace = ghostty-command-deck
quick-terminal-keyboard-interactivity = on-demand
quick-terminal-autohide = true

# ── Split workflow ───────────────────────────────────────────────────────────
# Vim navigation, arrows for measured resizing, and a compact split lifecycle.
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+left=resize_split:left,10
keybind = ctrl+shift+right=resize_split:right,10
keybind = ctrl+shift+up=resize_split:up,10
keybind = ctrl+shift+down=resize_split:down,10
keybind = ctrl+alt+d=new_split:right
keybind = ctrl+alt+shift+d=new_split:down
keybind = ctrl+shift+equal=equalize_splits
keybind = ctrl+shift+enter=toggle_split_zoom

# OMP multiline input and shell-integration prompt jumps.
keybind = shift+enter=text:\n
keybind = ctrl+alt+up=jump_to_prompt:-1
keybind = ctrl+alt+down=jump_to_prompt:1

# Smart copy falls through when no selection exists; scrollback opens as a file.
keybind = performable:ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+e=write_scrollback_file:open

# ── Signals, not noise ───────────────────────────────────────────────────────
bell-features = no-system,no-audio,attention,title,border
app-notifications = clipboard-copy,config-reload
