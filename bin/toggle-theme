#!/bin/bash

# Toggle the Linux system appearance and synchronize the Codex TUI theme.
# Usage: toggle-theme

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v omarchy >/dev/null 2>&1; then
    current="$(omarchy theme current 2>/dev/null || echo '')"
    if [[ "$current" =~ [Ll]ight|[Ll]atte ]]; then
        echo "Current theme is light ($current); switching to dark mode..."
        exec "$SCRIPT_DIR/dark-mode"
    else
        echo "Current theme is dark ($current); switching to light mode..."
        exec "$SCRIPT_DIR/light-mode"
    fi
fi

if ! command -v gsettings >/dev/null 2>&1; then
    echo "✗ Neither omarchy nor gsettings found; cannot read current system appearance" >&2
    exit 1
fi

if ! current_scheme="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)"; then
    echo "✗ Failed to read the current system appearance" >&2
    exit 1
fi

if [[ "$current_scheme" == *prefer-dark* ]]; then
    echo "Current system appearance is dark; switching to light mode..."
    exec "$SCRIPT_DIR/light-mode"
else
    echo "Current system appearance is light; switching to dark mode..."
    exec "$SCRIPT_DIR/dark-mode"
fi
