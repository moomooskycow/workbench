#!/bin/bash

# Set the Linux system appearance and synchronize the Codex TUI theme.
# On macOS, System Settings controls the appearance; this script still synchronizes Codex.
# Usage: dark-mode

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "Switching to dark mode..."

platform="$(uname -s)"
case "$platform" in
    Linux)
        if command -v omarchy >/dev/null 2>&1; then
            omarchy theme set "Tokyo Night"
        elif command -v gsettings >/dev/null 2>&1; then
            gsettings set org.gnome.desktop.interface color-scheme prefer-dark || {
                echo "✗ Failed to set Linux dark appearance" >&2
                exit 1
            }
        else
            echo "✗ Neither omarchy nor gsettings found; cannot set Linux appearance" >&2
            exit 1
        fi
        ;;
    Darwin)
        echo "macOS appearance is controlled in System Settings."
        ;;
    *)
        echo "✗ Unsupported platform: $platform" >&2
        exit 1
        ;;
esac

sync_output=""
if sync_output="$("$SCRIPT_DIR/sync-system-theme" --mode dark 2>&1)"; then
    [ -z "$sync_output" ] || printf '%s\n' "$sync_output"
    echo "✓ Dark mode activated"
else
    [ -z "$sync_output" ] || printf '%s\n' "$sync_output" >&2
    if [[ "$sync_output" == *"Codex config not found:"* ]]; then
        echo "Warning: Codex config not found; system appearance changed, but the Codex theme was not synchronized." >&2
        echo "✓ Dark mode activated"
    else
        echo "✗ Failed to synchronize the Codex theme" >&2
        exit 1
    fi
fi
